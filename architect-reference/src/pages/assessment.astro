---
/**
 * /assessment — kept as a short note so existing links still land somewhere useful. The scored
 * assessment test (<AssessmentTest>) is withdrawn; the practice-exam route is off in
 * astro.config.mjs. Every question stays readable, with its answer, on /answers/.
 */
import Base from '@brandon_m_behring/book-scaffold-astro/layouts/Base.astro';

const BASE = import.meta.env.BASE_URL;
---
<Base
  title="Assessment test (withdrawn) — The Claude Architect's Reference"
  description="The scored assessment test is withdrawn; every practice question, with its answer and rationale, is on the answers page."
>
  <article class="prose">
    <h1>Assessment test (withdrawn)</h1>
    <p>
      The scored assessment test is withdrawn. Its questions were written against Claude Code and
      the Claude API as they were in mid-2026, and some answer keys are under review, so a score
      would not measure what it claimed to.
    </p>
    <p>
      Every practice question, with its answer and rationale, is on the
      <a href={`${BASE}answers/`}>answers page</a>. Use the questions to test your understanding of a
      chapter, not to predict an exam result.
    </p>
  </article>
</Base>
