---
import Base from '@brandon_m_behring/book-scaffold-astro/layouts/Base.astro';
import ObjectiveMap from '@brandon_m_behring/book-scaffold-astro/components/ObjectiveMap.astro';
import { getCollection } from 'astro:content';

// The cert book is organized by CCA-F domain: domain → Part, task area → chapter.
// `part` (1–5) = domain number; `chapter` = part-relative (resets per part); display "D{part}.{chapter}".
// The scaffold's default index is flat — this landing groups by Part. (Logged as a
// scaffold-gap observation: a part-grouped TOC helper. See docs/scaffold-gaps.md.)
const PARTS = [
  { part: 1, domain: 'D1', title: 'Agentic Architecture & Orchestration' },
  { part: 2, domain: 'D2', title: 'Tool Design & MCP Integration' },
  { part: 3, domain: 'D3', title: 'Claude Code Configuration & Workflows' },
  { part: 4, domain: 'D4', title: 'Prompt Engineering & Structured Output' },
  { part: 5, domain: 'D5', title: 'Context Management & Reliability' },
];

const chapters = await getCollection('chapters', (entry) => !entry.data.draft);
const byPart = (p) =>
  chapters
    .filter((c) => (c.data.part ?? 0) === p)
    .sort((a, b) => (a.data.chapter ?? 0) - (b.data.chapter ?? 0));
// Links carry the book's base ('/architect/'): this page has no link rebaser, and a root-relative
// href would leave the book.
const BASE = import.meta.env.BASE_URL;
---
<Base title="The Claude Architect's Reference (study companion)" description="An unscored study companion in the claude-books series, organized around the five domains (D1–D5) publicly described for Anthropic's Claude Certified Architect — Foundations exam. References the Agentic Systems Design book for design depth.">
  <article class="prose">
    <h1>The Claude Architect's Reference</h1>
    <p class="subtitle"><em>Study companion — Claude Certified Architect: Foundations (D1–D5)</em></p>

    <p>This volume is organized around the five domains publicly described for Anthropic's <strong>Claude Certified Architect — Foundations</strong> exam. It offers reference prose with light study apparatus (objectives, watch-outs, self-checks), pointing outward to the <strong>Agentic Systems Design</strong> book where a domain needs design depth.</p>

    <p><strong>Status: an unscored study companion.</strong> It is independent of Anthropic, which has not reviewed or endorsed it, and it does not claim to match the exam's content or weighting. Its questions are for practice only: nothing here is scored, and nothing here predicts how you would do on the exam. Some chapters describe Claude Code and the Claude API as they were in mid-2026, so check them against <a href="https://platform.claude.com/docs">Anthropic's current documentation</a>. The glossary helps you find your way between the books; it is not a source of record for facts or for the exam.</p>

    <p>Every practice question, with its answer and rationale, is on the <a href={`${BASE}answers/`}>answers page</a>.</p>

    <h2>Domains</h2>
    {PARTS.map((p) => {
      const chs = byPart(p.part);
      return (
        <section>
          <h3>Part {p.part} · {p.domain} — {p.title}</h3>
          {chs.length === 0
            ? <p><em>No chapters authored yet — see <code>OUTLINE.md</code>.</em></p>
            : <ul>{chs.map((c) => (
                <li>
                  <a href={`${BASE}chapters/${c.id}/`}>
                    <strong>{p.domain}.{c.data.chapter}</strong> {c.data.title}
                  </a>
                </li>
              ))}</ul>}
        </section>
      );
    })}

    <h2>Practice questions by domain</h2>
    <p>Which chapters carry practice questions in each domain, derived from the question bank. Every question, with its answer and rationale, is on the <a href={`${BASE}answers/`}>answers page</a>.</p>
    <ObjectiveMap title="Chapters with practice questions, by domain" />

    <h2>Contents</h2>
    <p>All 30 chapters (D1.1–D5.6) are drafted as self-contained study chapters — each opens with a "Do I know this already?" diagnostic and closes with a summary of essentials. The question bank holds 75 questions. See <code>OUTLINE.md</code> for the chapter plan and <code>docs/BOOK-MAP.md</code> for how this book relates to the others.</p>
  </article>
</Base>
