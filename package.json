{
  "name": "claude-books",
  "version": "0.0.1",
  "private": true,
  "description": "Claude Code book ecosystem on book-scaffold-astro. Workspaces: handbook (Use), architect-reference (Cert · CCA-F D1–D5), agentic-systems-design (Design), agentic-coding (Use · cross-tool). See docs/BOOK-MAP.md.",
  "scripts": {
    "build": "npm run build --workspaces --if-present && node scripts/assemble-hub.mjs",
    "assemble": "node scripts/assemble-hub.mjs",
    "research:generate": "python3 scripts/generate-research-integrity.py --root .",
    "research:validate": "python3 scripts/validate-research-integrity.py --root .",
    "research:test": "python3 -m unittest discover -s tests/research_integrity -v"
  },
  "workspaces": [
    "handbook",
    "agentic-systems-design",
    "architect-reference",
    "agentic-coding",
    "hub"
  ],
  "license": "CC-BY-4.0"
}
